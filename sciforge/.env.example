# Copie para .env e preencha. NUNCA versione o .env real.
# Padrão 100% nuvem: preencha GEMINI_API_KEY, ANTHROPIC_API_KEY e OPENROUTER_API_KEY (ou ajuste o
# roteamento em config/settings.yaml para os provedores que você tem).

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Anthropic Claude (https://platform.claude.com) — provedor "claude" (kind: anthropic), SDK oficial
ANTHROPIC_API_KEY=

# OpenRouter (https://openrouter.ai/keys) — provedor "openrouter"; um endpoint para centenas de modelos
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenAI ou qualquer endpoint compatível (Azure, OpenRouter, vLLM, LM Studio...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- OPCIONAL: Ollama local -------------------------------------------------------------------
# Desnecessário no padrão (privacy_mode: cloud). Só é usado se você mudar privacy_mode para hybrid ou
# strict. O R e as proteções LGPD rodam localmente em qualquer modo.
# OLLAMA_HOST=http://localhost:11434
# Modelos (leves para GPUs de 4-8 GB; 12 GB+: qwen2.5-coder:14b + qwen2.5vl:7b; 24 GB+: qwen2.5-coder:32b):
# SCIFORGE_OLLAMA_MODEL=qwen2.5-coder:7b
# SCIFORGE_OLLAMA_VISION_MODEL=qwen2.5vl:3b
# SCIFORGE_OLLAMA_NUM_CTX=8192

# E-mail para o "polite pool" de OpenAlex/Crossref/Unpaywall (enviado no User-Agent)
POLITE_EMAIL=pesquisador@instituicao.br

# Opcional: chave da Semantic Scholar (https://www.semanticscholar.org/product/api#api-key-form).
# Enviada no header x-api-key; sem ela o limite público é baixo e um 429 apenas tira essa fonte da busca.
SEMANTIC_SCHOLAR_API_KEY=

# Opcional: diretório raiz do SciForge (prompts, config, scripts_r) quando instalado fora do modo editável
# SCIFORGE_HOME=/caminho/para/sciforge

# Opcional: caminhos explícitos de executáveis (úteis no Windows quando não estão no PATH)
# SCIFORGE_RSCRIPT=C:\Program Files\R\R-4.4.1\bin\Rscript.exe
# SCIFORGE_QUARTO=C:\Program Files\Quarto\bin\quarto.exe
# SCIFORGE_PANDOC=C:\Program Files\Quarto\bin\tools\pandoc.exe
